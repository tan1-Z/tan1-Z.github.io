{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tingchuan-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "MahjongRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["MahjongRoom"]}],
  "vars": {"ALLOWED_ORIGINS": "https://tan1-z.github.io,http://127.0.0.1:4173,http://localhost:4173"},
  "observability": {"enabled": false}
}
